PORT=3000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://pwademo:pwademo@localhost:5432/pwademo

# Generate via: npm run gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Set to enable the headless load-test bot harness. Empty/unset = bot
# connections are refused. Generate something like:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LOADTEST_TOKEN=
ADMIN_TOKEN=

# Used by deploy/ Python CLI to SSH into the LAN target. Override per host.
# If python-dotenv is installed, deploy/ picks these up from this file.
PWADEMO_HOST=
PWADEMO_USER=
PWADEMO_PASSWORD=
PWADEMO_PORT=22
